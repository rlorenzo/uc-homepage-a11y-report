{
  "name": "uc-homepage-a11y-report",
  "version": "1.0.0",
  "description": "Monthly accessibility report covering University of California homepages, admissions sites, and schools and colleges",
  "type": "module",
  "scripts": {
    "scan": "node scan/run.mjs",
    "verify": "node scripts/verify-all.mjs",
    "check": "biome check && fallow audit",
    "check:fix": "biome check --write && fallow fix && fallow audit",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "fallow": "fallow",
    "a11y": "start-server-and-test a11y:serve http://localhost:3000 a11y:scan",
    "a11y:serve": "serve site -l 3000 --no-clipboard",
    "a11y:scan": "pa11y-ci",
    "build:cf": "rm -rf site/data && mkdir -p site/data && cp data/history.json site/data/history.json",
    "prepare": "husky"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.1",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "fallow": "^2.67.0",
    "husky": "^9.1.7",
    "pa11y-ci": "^4.1.0",
    "serve": "^14.2.4",
    "start-server-and-test": "^2.0.10",
    "wrangler": "^4.0.0"
  }
}
