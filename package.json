{
  "name": "uc-homepage-a11y-report",
  "version": "1.0.0",
  "description": "Monthly accessibility report covering University of California homepages, admissions sites, and schools and colleges",
  "type": "module",
  "scripts": {
    "scan": "node scan/run.mjs",
    "verify": "node scripts/verify-all.mjs",
    "check": "biome check && fallow audit",
    "check:fix": "biome check --write && fallow fix && fallow audit",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "fallow": "fallow",
    "a11y": "start-server-and-test a11y:serve http://localhost:3000 a11y:scan",
    "a11y:serve": "serve site -l 3000 --no-clipboard",
    "a11y:scan": "pa11y-ci",
    "minify:css": "node scripts/minify-css.mjs",
    "build": "npm run minify:css && rm -rf site/data && mkdir -p site/data && cp data/history.json site/data/history.json",
    "prepare": "husky"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.3",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "fallow": "^2.77.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.32.0",
    "pa11y-ci": "^4.1.1",
    "serve": "^14.2.4",
    "start-server-and-test": "^3.0.5",
    "wrangler": "^4.103.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    },
    "ip-address": "~10.4.0",
    "puppeteer": "^25.9.0",
    "puppeteer-core": "^25.9.0"
  }
}
